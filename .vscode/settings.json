{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.terminal.activateEnvironment": true,
  "terminal.integrated.env.osx": { "DBT_PROFILES_DIR": "${workspaceFolder}" },
  "terminal.integrated.env.linux": { "DBT_PROFILES_DIR": "${workspaceFolder}" },
  "terminal.integrated.env.windows": { "DBT_PROFILES_DIR": "${workspaceFolder}" },
  "files.associations": { "*.sql": "jinja-sql" },
  "dbt.dbtPythonPathOverride": "${workspaceFolder}/.venv/bin/python",
  "files.exclude": { "**/__pycache__": true, "target": true, "logs": true }
}
